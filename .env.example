# Database (SQLite for local dev — change URL for PostgreSQL in production)
DATABASE_URL=sqlite:///./payguard.db

# NOVA API (server-side only — NEVER expose this key to the frontend)
NOVA_API_KEY=your_nova_api_key_here
NOVA_API_URL=https://www.aczen.in/nova-api/v1

# Application
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Control Configuration (±5% tolerance)
PO_PRICE_TOLERANCE=0.05
PO_QUANTITY_TOLERANCE=0.05

# Approval Thresholds
APPROVAL_THRESHOLD_LOW=5000
APPROVAL_THRESHOLD_MEDIUM=25000
